rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff', 'Owner', 'Staff'];
    }

    function validOrder() {
      // Every customer order must belong to a Firebase Auth session. Guests use Anonymous Auth; this is still authentication, not a sign-in requirement.
      return request.resource.data.keys().hasOnly([
          'customerId',
          'createdAt',
          'customerName',
          'phone',
          'mode',
          'scheduledFor',
          'deliveryLocation',
          'instructions',
          'items',
          'total',
          'status'
        ])
        && request.resource.data.keys().hasAll([
          'createdAt',
          'customerName',
          'phone',
          'mode',
          'scheduledFor',
          'deliveryLocation',
          'instructions',
          'items',
          'total',
          'status'
        ])
        && request.resource.data.createdAt is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.mode in ['pickup', 'delivery']
        && request.resource.data.scheduledFor is string
        && request.resource.data.deliveryLocation is string
        && request.resource.data.instructions is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'New'
        && (
          !request.resource.data.keys().hasAny(['customerId'])
          || request.resource.data.customerId is string
        );
    }

    function validCustomer(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'preferredDeliveryLocation',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.preferredDeliveryLocation is string
        && request.resource.data.notes is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function validReconciliation() {
      return request.resource.data.keys().hasOnly([
        'date',
        'actualCash',
        'actualETransfer',
        'actualOther',
        'notes',
        'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'date',
        'actualCash',
        'actualETransfer',
        'actualOther',
        'notes',
        'updatedAt'
      ])
      && request.resource.data.date is string
      && request.resource.data.actualCash is number
      && request.resource.data.actualCash >= 0
      && request.resource.data.actualETransfer is number
      && request.resource.data.actualETransfer >= 0
      && request.resource.data.actualOther is number
      && request.resource.data.actualOther >= 0
      && request.resource.data.notes is string
      && request.resource.data.updatedAt is string;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /customers/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validCustomer(uid);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if validOrder()
        && request.resource.data.keys().hasAll(['customerId'])
        && isOwner(request.resource.data.customerId);

      allow read: if isAdmin()
        || (
          resource.data.keys().hasAny(['customerId'])
          && isOwner(resource.data.customerId)
        );

      allow update, delete: if isAdmin();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notificationPreferences/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['enabled','leadMinutes','updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.leadMinutes in [5,10,15,20,30,45,60]
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
    }

    match /notificationTokens/{uid}/tokens/{tokenId} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['token','admin','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.admin is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
      allow read: if false;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.lastMessageAt is string
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.unreadForCustomer is bool
        && request.resource.data.unreadForAdmin is bool;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessageAt','lastMessagePreview','unreadForCustomer','unreadForAdmin','customerLastReadAt']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ['customer','admin']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string
          && (
            (request.resource.data.senderRole == 'customer' && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid)
            || (request.resource.data.senderRole == 'admin' && isAdmin())
          );
        allow update, delete: if false;
      }
    }

    match /sourcingRequests/{requestId} {
      function validSourcingRequest() {
        return request.resource.data.keys().hasOnly([
            'customerId',
            'customerName',
            'phone',
            'product',
            'size',
            'colour',
            'notes',
            'attachment',
            'createdAt',
            'updatedAt',
            'status',
            'deliveryMethod'
          ])
          && request.resource.data.keys().hasAll([
            'customerId',
            'customerName',
            'phone',
            'product',
            'size',
            'colour',
            'notes',
            'attachment',
            'createdAt',
            'updatedAt',
            'status',
            'deliveryMethod'
          ])
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.customerName is string
          && request.resource.data.phone is string
          && request.resource.data.product is string
          && request.resource.data.product.size() > 0
          && request.resource.data.size is string
          && request.resource.data.colour is string
          && request.resource.data.notes is string
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && request.resource.data.status == 'New Request'
          && request.resource.data.deliveryMethod in ['delivery', 'collection']
          && (
            request.resource.data.attachment == null
            || (
              request.resource.data.attachment is map
              && request.resource.data.attachment.keys().hasOnly(['url', 'name', 'type', 'size'])
              && request.resource.data.attachment.url is string
              && request.resource.data.attachment.name is string
              && request.resource.data.attachment.type is string
              && request.resource.data.attachment.size is number
              && request.resource.data.attachment.size <= 10485760
            )
          );
      }

      allow create: if signedIn() && !isAdmin() && validSourcingRequest();
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /storefrontContent/{contentId} {
      function validStorefrontContent() {
        return request.resource.data.keys().hasOnly([
            'type', 'category', 'title', 'description', 'imageUrl',
            'price', 'originalPrice', 'status', 'audience', 'startsAt',
            'endsAt', 'ctaLabel', 'sortOrder', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'type', 'title', 'description', 'imageUrl', 'price', 'status',
            'audience', 'startsAt', 'endsAt', 'ctaLabel', 'sortOrder',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.type in ['find', 'deal']
          && (
            !request.resource.data.keys().hasAny(['category'])
            || request.resource.data.category in [
              'Sneakers', 'Apparel', 'Accessories', 'Kids', 'Other'
            ]
          )
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() > 0
          && request.resource.data.status in [
            'draft', 'scheduled', 'published', 'paused', 'archived'
          ]
          && request.resource.data.audience in ['everyone', 'circle']
          && request.resource.data.startsAt is string
          && request.resource.data.endsAt is string
          && request.resource.data.ctaLabel is string
          && request.resource.data.sortOrder is number
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && (
            !request.resource.data.keys().hasAny(['originalPrice'])
            || (
              request.resource.data.originalPrice is number
              && request.resource.data.originalPrice > 0
            )
          )
          && (
            request.resource.data.type != 'deal'
            || (
              request.resource.data.keys().hasAll(['price', 'originalPrice'])
              && request.resource.data.originalPrice > request.resource.data.price
            )
          );
      }

      allow read: if isAdmin()
        || (
          resource.data.status in ['published', 'scheduled']
          && resource.data.audience == 'everyone'
        );

      allow create: if isAdmin() && validStorefrontContent();
      allow update: if isAdmin() && validStorefrontContent();
      allow delete: if isAdmin();
    }

    match /memberships/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update, delete: if isAdmin();
    }

    match /memberSettings/{uid} {
      allow read: if isAdmin() || isOwner(uid) || resource.data.showInCircle == true;
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['uid','displayName','sharePurchases','showInCircle','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.sharePurchases in ['private','friends','public']
        && request.resource.data.showInCircle is bool
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /memberFeedPreferences/{uid} {
      function isConnectedMember(otherUid) {
        return exists(/databases/$(database)/documents/friendConnections/$(request.auth.uid + '_' + otherUid))
          || exists(/databases/$(database)/documents/friendConnections/$(otherUid + '_' + request.auth.uid));
      }
      function validFeedPreferences() {
        return request.resource.data.keys().hasOnly(['uid','shareInterests','interests','updatedAt'])
          && request.resource.data.keys().hasAll(['uid','shareInterests','interests','updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.shareInterests is bool
          && request.resource.data.interests is map
          && request.resource.data.interests.keys().hasOnly(['newDrops','seasonalBuys','loyaltyUpdates'])
          && request.resource.data.interests.newDrops is bool
          && request.resource.data.interests.seasonalBuys is bool
          && request.resource.data.interests.loyaltyUpdates is bool
          && request.resource.data.updatedAt is string;
      }
      allow read: if isAdmin() || isOwner(uid)
        || (signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && resource.data.shareInterests == true && isConnectedMember(uid));
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && validFeedPreferences();
      allow delete: if false;
    }

    match /friendInvites/{inviteId} {
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['inviterUid','inviterName','status','createdAt','expiresAt'])
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.inviterName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow read: if isAdmin() || (signedIn() && (resource.data.inviterUid == request.auth.uid || (resource.data.status == 'pending' && resource.data.expiresAt > request.time)));
      allow update: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && resource.data.inviterUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','recipientUid','acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.acceptedAt is string;
      allow delete: if isAdmin() || (signedIn() && resource.data.inviterUid == request.auth.uid && resource.data.status == 'pending');
    }

    match /friendConnections/{connectionId} {
      function validAcceptedInvite() {
        let invitePath = /databases/$(database)/documents/friendInvites/$(request.resource.data.inviteId);
        return request.resource.data.keys().hasOnly(['memberA','memberB','inviteId','createdAt'])
          && request.resource.data.keys().hasAll(['memberA','memberB','inviteId','createdAt'])
          && request.resource.data.memberA is string
          && request.resource.data.memberB is string
          && (
            connectionId == request.resource.data.memberA + '_' + request.resource.data.memberB
            || connectionId == request.resource.data.memberB + '_' + request.resource.data.memberA
          )
          && request.resource.data.inviteId is string
          && request.resource.data.createdAt is string
          && existsAfter(invitePath)
          && getAfter(invitePath).data.status == 'accepted'
          && getAfter(invitePath).data.recipientUid == request.auth.uid
          && (
            (getAfter(invitePath).data.inviterUid == request.resource.data.memberA
              && getAfter(invitePath).data.recipientUid == request.resource.data.memberB)
            || (getAfter(invitePath).data.inviterUid == request.resource.data.memberB
              && getAfter(invitePath).data.recipientUid == request.resource.data.memberA)
          );
      }

      allow get: if isAdmin() || (signedIn()
        && (!exists(/databases/$(database)/documents/friendConnections/$(connectionId))
          || resource.data.memberA == request.auth.uid
          || resource.data.memberB == request.auth.uid));
      allow list: if isAdmin() || (signedIn()
        && (resource.data.memberA == request.auth.uid || resource.data.memberB == request.auth.uid));
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && validAcceptedInvite();
      allow update: if false;
      allow delete: if isAdmin() || (signedIn()
        && (resource.data.memberA == request.auth.uid || resource.data.memberB == request.auth.uid));
    }

    match /communityActivity/{activityId} {
      function validPublishedActivity() {
        let sourcePath = /databases/$(database)/documents/sourcingRequests/$(request.resource.data.sourceRequestId);
        let settingsPath = /databases/$(database)/documents/memberSettings/$(request.resource.data.ownerUid);
        return request.resource.data.keys().hasOnly(['ownerUid','sourceRequestId','productLabel','audience','status','createdAt','updatedAt','publishedAt'])
          && request.resource.data.keys().hasAll(['ownerUid','sourceRequestId','productLabel','audience','status','createdAt','updatedAt','publishedAt'])
          && request.resource.data.ownerUid is string
          && request.resource.data.sourceRequestId is string
          && request.resource.data.productLabel is string
          && request.resource.data.productLabel.size() > 0
          && request.resource.data.productLabel.size() <= 120
          && request.resource.data.audience in ['friends','public']
          && request.resource.data.status == 'published'
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && request.resource.data.publishedAt is string
          && exists(sourcePath)
          && get(sourcePath).data.customerId == request.resource.data.ownerUid
          && get(sourcePath).data.status in ['Delivered','Collected']
          && exists(settingsPath)
          && get(settingsPath).data.sharePurchases == request.resource.data.audience;
      }

      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (resource.data.status == 'published' && resource.data.audience == 'public')
        || (signedIn() && resource.data.status == 'published' && resource.data.audience == 'friends'
          && resource.data.ownerUid != request.auth.uid
          && (
            exists(/databases/$(database)/documents/friendConnections/$(resource.data.ownerUid + '_' + request.auth.uid))
            || exists(/databases/$(database)/documents/friendConnections/$(request.auth.uid + '_' + resource.data.ownerUid))
          ));
      allow create: if isAdmin() && validPublishedActivity();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['published','archived']
        && request.resource.data.updatedAt is string;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /customerJourneyEvents/{eventId} {
      allow read: if isAdmin();
      // Events are written only by the authenticated server route, never directly by clients.
      allow create, update, delete: if false;
    }

    match /dailyReconciliations/{date} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validReconciliation();
    }


    // Yusuf service catalogue: customer-readable active services, admin-managed CRUD.
    match /tailoringServices/{serviceId} {
      function validTailoringService() {
        return request.resource.data.keys().hasOnly([
            'name', 'category', 'description', 'priceLabel', 'illustrativePrice',
            'imageUrl', 'active', 'sortOrder', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'category', 'description', 'priceLabel', 'illustrativePrice',
            'imageUrl', 'active', 'sortOrder', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.priceLabel is string
          && request.resource.data.priceLabel.size() <= 120
          && (request.resource.data.illustrativePrice == null
            || (request.resource.data.illustrativePrice is number && request.resource.data.illustrativePrice >= 0))
          && request.resource.data.imageUrl is string
          && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('https://.*'))
          && request.resource.data.active is bool
          && request.resource.data.sortOrder is number
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }

      allow read: if true; // Catalogue records contain public service information only.
      allow create: if isAdmin() && validTailoringService();
      allow update: if isAdmin() && validTailoringService();
      // Requests store service name/price snapshots, so removing a service cannot rewrite history.
      allow delete: if isAdmin();
    }

    // Private customer request and operations record. A request is not an order/quote until
    // Yusuf records those separate business decisions.
    match /tailoringRequests/{requestId} {
      function validNewTailoringRequest() {
        return request.resource.data.keys().hasOnly([
            'customerId', 'customerName', 'phone', 'email', 'requestType',
            'serviceId', 'serviceName', 'garmentType', 'stylePreferences',
            'fabricPreferences', 'measurements', 'needsFittingHelp',
            'preferredFittingDate', 'referenceImage', 'notes', 'status',
            'quoteStatus', 'paymentStatus', 'productionStage', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'customerId', 'customerName', 'phone', 'email', 'requestType',
            'serviceId', 'serviceName', 'garmentType', 'stylePreferences',
            'fabricPreferences', 'measurements', 'needsFittingHelp',
            'preferredFittingDate', 'referenceImage', 'notes', 'status',
            'quoteStatus', 'paymentStatus', 'productionStage', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() > 0
          && request.resource.data.customerName.size() <= 120
          && request.resource.data.phone is string
          && request.resource.data.phone.size() > 0
          && request.resource.data.phone.size() <= 60
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 200
          && request.resource.data.requestType == 'quote_request'
          && request.resource.data.serviceId is string
          && request.resource.data.serviceId.size() <= 120
          && request.resource.data.serviceName is string
          && request.resource.data.serviceName.size() > 0
          && request.resource.data.serviceName.size() <= 120
          && request.resource.data.garmentType is string
          && request.resource.data.garmentType.size() > 0
          && request.resource.data.garmentType.size() <= 120
          && request.resource.data.stylePreferences is string
          && request.resource.data.stylePreferences.size() <= 1500
          && request.resource.data.fabricPreferences is string
          && request.resource.data.fabricPreferences.size() <= 500
          && request.resource.data.measurements is string
          && request.resource.data.measurements.size() <= 3000
          && request.resource.data.needsFittingHelp is bool
          && request.resource.data.preferredFittingDate is string
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 3000
          && request.resource.data.status == 'new'
          && request.resource.data.quoteStatus == 'not_quoted'
          && request.resource.data.paymentStatus == 'unpaid'
          && request.resource.data.productionStage == 'not_started'
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && (
            request.resource.data.referenceImage == null
            || (
              request.resource.data.referenceImage is map
              && request.resource.data.referenceImage.keys().hasOnly(['storagePath', 'name', 'type', 'size'])
              && request.resource.data.referenceImage.storagePath is string
              && request.resource.data.referenceImage.storagePath.matches('tailoringReferences/' + request.auth.uid + '/' + requestId + '/.*')
              && request.resource.data.referenceImage.name is string
              && request.resource.data.referenceImage.name.size() <= 180
              && request.resource.data.referenceImage.type in ['image/jpeg', 'image/png', 'image/webp', 'image/avif']
              && request.resource.data.referenceImage.size is number
              && request.resource.data.referenceImage.size > 0
              && request.resource.data.referenceImage.size <= 5 * 1024 * 1024
            )
          );
      }

      function validAdminRequestUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'quoteStatus', 'quoteAmount', 'quoteNotes',
            'depositRequired', 'depositPaid', 'paymentStatus',
            'productionStage', 'fittingDate', 'dueDate', 'collectionMethod',
            'adminNotes', 'completedAt', 'collectedAt', 'updatedAt'
          ])
          && (request.resource.data.status in [
            'new', 'reviewing', 'awaiting_customer', 'quote_ready', 'confirmed',
            'in_production', 'ready_for_fitting', 'alterations', 'ready_for_collection',
            'completed', 'collected', 'cancelled'
          ] || (resource.data.status == 'quote_accepted' && request.resource.data.status == 'quote_accepted'))
          && (request.resource.data.quoteStatus in ['not_quoted', 'ready', 'declined'] || (resource.data.quoteStatus == 'accepted' && request.resource.data.quoteStatus == 'accepted'))
          && request.resource.data.paymentStatus in ['unpaid', 'deposit_pending', 'partially_paid', 'paid', 'refunded']
          && request.resource.data.productionStage in [
            'not_started', 'awaiting_fabric', 'cutting', 'sewing', 'fitting',
            'alterations', 'quality_check', 'ready_for_collection', 'collected', 'cancelled'
          ]
          && (!request.resource.data.keys().hasAny(['quoteAmount'])
            || request.resource.data.quoteAmount == null
            || (request.resource.data.quoteAmount is number && request.resource.data.quoteAmount >= 0))
          && (!request.resource.data.keys().hasAny(['quoteAcceptedAmount'])
            || (request.resource.data.quoteAcceptedAmount is number && request.resource.data.quoteAcceptedAmount >= 0))
          && (!request.resource.data.keys().hasAny(['depositRequired'])
            || request.resource.data.depositRequired == null
            || (request.resource.data.depositRequired is number && request.resource.data.depositRequired >= 0))
          && (!request.resource.data.keys().hasAny(['depositPaid'])
            || request.resource.data.depositPaid == null
            || (request.resource.data.depositPaid is number && request.resource.data.depositPaid >= 0))
          && (!request.resource.data.keys().hasAny(['quoteNotes']) || request.resource.data.quoteNotes is string)
          && (!request.resource.data.keys().hasAny(['adminNotes']) || request.resource.data.adminNotes is string)
          && (!request.resource.data.keys().hasAny(['fittingDate']) || request.resource.data.fittingDate is string)
          && (!request.resource.data.keys().hasAny(['dueDate']) || request.resource.data.dueDate is string)
          && (!request.resource.data.keys().hasAny(['collectionMethod']) || request.resource.data.collectionMethod in ['collection', 'delivery', 'not_set'])
          && request.resource.data.updatedAt is string;
      }

      allow create: if signedIn() && !isAdmin() && validNewTailoringRequest();
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() && validAdminRequestUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}