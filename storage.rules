rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function isAdmin(){return request.auth!=null&&firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))&&firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff','Owner','Staff'];}
  match /boemoMedia/{fileName}{allow read:if true;allow write:if isAdmin()&&request.resource.size<12*1024*1024&&request.resource.contentType.matches('image/.*');}
  match /storefrontMedia/{fileName} {
    allow read: if true;
    allow write: if isAdmin() && request.resource.size < 12*1024*1024 && request.resource.contentType.matches('image/.*');
  }
  match /conversationAttachments/{conversationId}/{messageId}/{fileName}{
    allow read: if request.auth!=null
      && (
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff','Owner','Staff'])
        || firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.customerId==request.auth.uid
      );
    allow write: if request.auth!=null
      && (
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff','Owner','Staff'])
        || firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.customerId==request.auth.uid
      )
      && request.resource.size<10*1024*1024
      && (request.resource.contentType.matches('image/.*')||request.resource.contentType=='application/pdf');
  }
  // Private customer reference images: never grant public reads.
  match /tailoringReferences/{uid}/{requestId}/{fileName} {
    allow read: if request.auth != null
      && (request.auth.uid == uid || isAdmin());
    allow create, update: if request.auth != null
      && request.auth.uid == uid
      && request.resource.size > 0
      && request.resource.size <= 5 * 1024 * 1024
      && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/avif']
      && request.resource.metadata.ownerUid == uid
      && request.resource.metadata.requestId == requestId;
    allow delete: if request.auth != null
      && (request.auth.uid == uid || isAdmin());
  }
  match /{allPaths=**}{allow read,write:if false;}
 }
}