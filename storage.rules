rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff', 'Owner', 'Staff'];
    }

    // Private customer reference images: access is limited to their owner and authorized staff.
    match /tailoringReferences/{uid}/{requestId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/avif']
        && request.resource.metadata.ownerUid == uid
        && request.resource.metadata.requestId == requestId;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Optional public catalogue photography; never store customer references here.
    match /tailoringServiceMedia/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
